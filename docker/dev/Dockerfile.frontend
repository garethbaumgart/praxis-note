FROM node:22-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY src/PraxisNote.Web/ClientApp/package*.json ./
RUN npm ci

# Source files are mounted as volume at runtime
# Using poll for file watching in Docker
EXPOSE 4200

ENTRYPOINT ["npm", "run", "start", "--", "--host", "0.0.0.0", "--poll", "1000", "--proxy-config", "proxy.conf.docker.json"]
